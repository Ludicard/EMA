# ==========================================
# Variables de Entorno - EMA VPS Deployment
# ==========================================

# 1. Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ema

# (Dentro de docker, la red resolverá "db:5432")
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

# 2. Puerto del Backend
PORT=4000

# 3. URL del Backend para el Frontend (Debe ser la IP de tu VPS o el dominio para NPM)
# Ejemplos con Nginx Proxy Manager:
# VITE_API_URL=https://api.midominio.com
# VITE_API_URL=http://TUPUBLICAIP:4000 (Si expusieras el puerto, que no es el caso actual)
VITE_API_URL=https://api.aurelianova.tech
